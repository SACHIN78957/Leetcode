class Solution {
public:
    string multiply(string num1, string num2) {
        int n=num1.length(),m=num2.length();
        if(num1=="0" || num2=="0")
        {
            return "0";
        }
        
        vector<int> res(n+m,0);
        for(int i=n-1;i>=0;i--)
        {
            for(int j=m-1;j>=0;j--)
            {
                int a=num1[i]-'0';
                int b=num2[j]-'0';

                int product=a*b;

                int pos1=i+j;
                int pos2=i+j+1;

                int sum=product + res[pos2];

                res[pos2]=sum%10;
                res[pos1]+=sum/10;
            }
        }
        string ans="";
        for(int i=0;i<res.size();i++)
        {
            if(ans.empty() && res[i]==0)
            {
                continue;
            }
            ans+=char(res[i]+'0');
        }
        return ans;
    }
};
